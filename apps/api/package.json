{
  "name": "@ai-homeroom/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:postgres",
    "dev:postgres": "node scripts/dev-server.mjs postgres",
    "dev:memory": "node scripts/dev-server.mjs memory",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test test/app.test.ts test/learning-plan.validation.test.ts test/learning-plan.scheduler.test.ts test/learning-plan.api.test.ts test/learning-plan-catalog-fixture.test.ts test/learning-plan-distribution-check.test.ts test/llm-chat.test.ts test/llm-chat-tools.test.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:check": "tsx src/db/check.ts",
    "test:db": "tsx --test test/db.integration.test.ts",
    "test:db:learning-plan": "node --env-file=../../.env.learning-plan-test.local --import tsx --test test/learning-plan.repository.test.ts test/learning-plan-student-directory.test.ts",
    "verify:learning-plan": "node --env-file=../../.env.learning-plan-test.local --import tsx scripts/verify-learning-plan-http.ts",
    "verify:learning-plan:distribution": "node --import tsx scripts/verify-learning-plan-distribution.ts",
    "verify:learning-plan:distribution-http": "node --env-file=../../.env.learning-plan-test.local --import tsx scripts/verify-learning-plan-distribution-http.ts",
    "verify:learning-plan:llm": "node --env-file=../../.env.learning-plan-test.local --env-file=../../.env.llm.local --import tsx scripts/verify-learning-plan-llm.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.7.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
